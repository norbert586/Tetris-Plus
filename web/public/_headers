# Cloudflare Pages response headers (docs/deploy.md).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Built code has content hashes in its names.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable
/assets/worklet-*
  Cache-Control: public, max-age=31536000, immutable

# Game data keeps its name across deploys: cached for a day, then revalidated.
/assets/*.pack
  Cache-Control: public, max-age=86400
/assets/music/*
  Cache-Control: public, max-age=86400
